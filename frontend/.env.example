# Shift Booking App - API Configuration
# Copy this file to .env and update the URL to match your backend.
#
# Physical Android device on LAN:
#   EXPO_PUBLIC_API_URL=http://192.168.1.X:8080
#
# Android emulator:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
#
# iOS simulator:
#   EXPO_PUBLIC_API_URL=http://localhost:8080
#
# iOS physical device:
#   EXPO_PUBLIC_API_URL=http://192.168.1.X:8080
#
# The backend must be reachable from the device/emulator at this URL.
EXPO_PUBLIC_API_URL=
